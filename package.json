{
  "name": "ymzz-loop",
  "version": "1.11.0",
  "description": "Zero-cost daily review & holdings journal: GitHub Actions creates your Notion page, emails a reminder, and syncs yesterday to Google Sheets + Markdown. Any time zone. \u6bcf\u65e5\u5fa9\u76e4\uff0c\u96f6\u6210\u672c\u81ea\u52d5\u5316\u3002",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "YanMing Cao \u66f9\u664f\u9298 (\u664f\u9298\u6e5b\u7bb4) (https://github.com/Ya-MiC)",
  "homepage": "https://ya-mic.github.io/ymzz-loop/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ya-MiC/ymzz-loop.git"
  },
  "bugs": {
    "url": "https://github.com/Ya-MiC/ymzz-loop/issues"
  },
  "keywords": [
    "notion",
    "github-actions",
    "journal",
    "daily-review",
    "google-sheets",
    "trading-journal",
    "kpt",
    "retrospective",
    "productivity",
    "ibkr"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup-notion.mjs",
    "gate": "node scripts/gate.mjs",
    "create-today": "node scripts/create-today.mjs",
    "send-reminder": "node scripts/send-reminder.mjs",
    "sync-yesterday": "node scripts/sync-yesterday.mjs",
    "write-log": "node scripts/write-log.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "notion-to-md": "^3.1.1",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.9.15"
  }
}
